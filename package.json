{
  "name": "santoto-launch-programs",
  "private": true,
  "version": "0.1.0",
  "description": "Gamified launch experience for Santoto Tunja programs",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": { "concurrently": "^9.1.2" },
  "engines": { "node": ">=20.0.0" }
}
